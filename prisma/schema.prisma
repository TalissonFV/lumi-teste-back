generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Fatura {
  id                                    Int      @id @default(autoincrement())
  numeroCliente                         String
  // cliente                               Cliente  @relation(fields: [numeroCliente], references: [numeroCliente])
  mesFatura                             String
  qtdEnergiaEletrica                    Int
  qtdEnergiaSCEE                        Int
  qtdEnergiaCompensada                  Int
  consumoEnergiaEletrica                Int
  valorEnergiaEletrica                  Float
  valorEnergiaSCEE                      Float
  valorEnergiaCompensada                Float
  valorContribuicaoIlumPublicaMunicipal Float
  valorTotalSemGD                       Float
  total                                 Float
}

